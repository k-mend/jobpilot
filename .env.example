# Copy to .env. The app runs locally with sensible defaults; the items below unlock
# the full product (durable storage, logins, email alerts).

# --- LLM (optional). Without any key, JobPilot uses the free template fallback. ---
# Provider priority: OpenRouter is used if its key is set, otherwise Gemini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Database ---
# Local dev/tests: SQLite (default). Production: your Neon Postgres URL.
# See docs/DATABASE_NEON.md. Example Neon URL:
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///jobpilot.db

# --- Auth / app ---
# APP_SECRET signs login cookies — set a long random value in production.
APP_SECRET=change-me-to-a-long-random-string
BASE_URL=http://127.0.0.1:8000

# --- Email alerts (Gmail SMTP). See docs/EMAIL_ALERTS.md for the App Password steps. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Job sources: custom company boards (comma-separated slugs/tokens) ---
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=

# --- Scan behavior ---
SCAN_MAX_RESULTS=50
TAILOR_TOP_N=5
SCAN_MIN_SCORE=25

# --- Retention / monthly cleanup (days). See docs/RETENTION.md. ---
RETAIN_ARCHIVED_DAYS=90
RETAIN_STALE_MATCHED_DAYS=35
RETAIN_ORPHAN_JOB_DAYS=45
