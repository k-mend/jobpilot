# Copy to .env. All values are optional — the app runs free with none of them.

# --- LLM (optional). Without any key, JobPilot uses the free template fallback. ---
# Provider priority: OpenRouter is used if its key is set, otherwise Gemini.

# OpenRouter — has genuinely free models. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Google Gemini — free tier available (gemini-1.5-flash). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Database ---
DATABASE_URL=sqlite:///jobpilot.db

# --- Job sources: custom company boards (comma-separated slugs/tokens) ---
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=

# --- Scan behavior ---
SCAN_MAX_RESULTS=50
TAILOR_TOP_N=5

# --- App ---
APP_SECRET=change-me
