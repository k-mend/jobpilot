# Copy to .env. All values are optional — the app runs free with none of them.

# --- LLM (optional). Without a key, JobPilot uses the free template fallback. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Database ---
DATABASE_URL=sqlite:///jobpilot.db

# --- Job sources: custom company boards (comma-separated slugs/tokens) ---
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=

# --- Scan behavior ---
SCAN_MAX_RESULTS=50
TAILOR_TOP_N=5

# --- App ---
APP_SECRET=change-me
